# Port exposed on localhost for the OmniRoute gateway and dashboard.
OMNIROUTE_PORT=20128

# OmniRoute routing model used by Hermes Agent.
DEFAULT_MODEL=auto

# Relative paths are resolved from the HermesUnchained repository root.
HERMES_HOME_DIR=.hermes-home

# Local placeholder accepted by OmniRoute. Do not put real secrets in this file.
DUMMY_KEY=sk-dummy
